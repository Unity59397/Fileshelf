# FileShelf settings. Copy this file to .env and change the values.
# The server reads environment variables only. To load this file, run from the server folder:
#   npm run start:env
# or pass the file to Docker or systemd with their own env-file options.
# Never commit .env. Every value below is a placeholder, not a real secret.

# Where the server listens.
PORT=3000

# Public address of the site. Must start with https:// when NODE_ENV=production.
BASE_URL=http://localhost:3000

# Signs download links. Use a long random string (32+ characters) in production, for example:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
APP_SECRET=change-me-to-a-long-random-string

# The first account that signs up with this email becomes the admin, but only while no admin exists.
# After that, admins change roles from the Admin > Users page.
ADMIN_EMAIL=

# Shown on the Help page and in the footer. Leave empty until you have a public contact address.
CONTACT_EMAIL=

# Where the database, uploads and temporary files live. Back this folder up.
# DATA_DIR=./server/data
# DB_FILE=

# off    every listing is free (default, and the only safe choice until payments are set up and tested)
# mock   test checkout, no money moves (development only; refused in production)
# stripe real payments (needs the two keys below; the live Stripe calls are not tested)
PAYMENTS=off
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Platform fee in basis points. 1000 = 10%.
PLATFORM_FEE_BPS=1000

# Upload limits and accepted file types.
MAX_UPLOAD_MB=200
MAX_IMAGE_MB=5
# ALLOWED_EXTENSIONS=zip,7z,rar,gz,tar,pdf,txt,md,json,csv,xlsx,docx,pptx,png,jpg,jpeg,webp

# Optional virus scanner. The file path is added to the end of the command.
# Exit code 0 = clean, 1 = infected, anything else = scan failed.
# SCAN_COMMAND=clamscan --no-summary

# Set to 1 when the site sits behind a reverse proxy, so visitor addresses come from X-Forwarded-For.
TRUST_PROXY=0

# Set to production on a live site. It refuses test payments, the default secret and a non-https BASE_URL.
NODE_ENV=development
