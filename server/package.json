{
  "name": "fileshelf-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "FileShelf server. No dependencies: Node 22.5+ built-ins only.",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/index.js",
    "dev": "node --watch --disable-warning=ExperimentalWarning src/index.js",
    "seed": "node --disable-warning=ExperimentalWarning src/seed.js",
    "test": "node --test --disable-warning=ExperimentalWarning \"test/*.test.js\"",
    "start:env": "node --env-file=../.env --disable-warning=ExperimentalWarning src/index.js"
  }
}
